# Required at build time. Production builds fail instead of publishing an
# empty site when Strapi cannot be reached.
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=

# Public site and generated Open Graph image URLs.
SITE_URL=http://localhost:4321
PUBLIC_ROBOTS=index, follow
OG_IMAGE_BASE_URL=
PUBLIC_OG_IMAGE_BASE_URL=
# Set this when Strapi returns relative /uploads/... media URLs or when media
# is served from a public object-storage/CDN host separate from STRAPI_URL.
PUBLIC_STRAPI_ASSET_BASE_URL=

# Optional S3-compatible Open Graph image publishing.
OG_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
