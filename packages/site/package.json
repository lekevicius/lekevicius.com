{
  "name": "lekevicius-v8",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro check && bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "preview:cloudflare": "bun run build && bunx wrangler dev",
    "deploy:cloudflare": "bun run build && bunx wrangler deploy",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "precommit": "lint-staged && bun run lint"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@sensinum/astro-strapi-blocks": "^1.5.0",
    "@sensinum/astro-strapi-loader": "^1.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/mime-types": "^3.0.1",
    "astro": "7.1.6",
    "astro-og-canvas": "^0.13.0",
    "mime-types": "^3.0.2",
    "qs": "^6.15.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.77.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "wrangler": "^4.120.1"
  },
  "lint-staged": {
    "*.{astro,css,html,js,json,jsonc,md,mjs,ts,yaml,yml}": "prettier --write"
  }
}
