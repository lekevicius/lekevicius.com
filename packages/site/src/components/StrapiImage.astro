---
import { Image } from "astro:assets";
import { getStrapiMediaUrl, type StrapiMediaSource } from "../lib/strapiTypes";

interface Props {
  src: StrapiMediaSource;
  alt: string;
  width?: number | null;
  height?: number | null;
  loading?: "eager" | "lazy";
  class?: string;
}

const { src, alt, width, height, loading, class: className } = Astro.props;
const normalizedSrc = getStrapiMediaUrl(src) ?? src;
---

{
  typeof normalizedSrc !== "string" ? (
    <Image
      src={normalizedSrc}
      width={width ?? undefined}
      height={height ?? undefined}
      loading={loading}
      alt={alt}
      class={className}
    />
  ) : width && height ? (
    <Image
      src={normalizedSrc}
      width={width}
      height={height}
      loading={loading}
      alt={alt}
      class={className}
    />
  ) : (
    <Image
      src={normalizedSrc}
      inferSize
      loading={loading}
      alt={alt}
      class={className}
    />
  )
}
