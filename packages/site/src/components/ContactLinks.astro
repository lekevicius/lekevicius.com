---
import footerContactLinks from "../content/footerContactLinks";
import ServiceIcon from "./ServiceIcon.astro";
---

<section class="column-blocks contact-section">
  {
    footerContactLinks.map((group) => (
      <div class="column-block">
        <h4>{group.title}</h4>
        <ul class="contact-links">
          {group.links.map((link) => {
            return (
              <li class:list={{ "service-link-email": link.copyValue }}>
                <a
                  href={link.href}
                  aria-label={link.tooltip}
                  data-tooltip={link.tooltip}
                  data-copy={link.copyValue}
                  data-copy-toast={link.copyValue ? "Email copied!" : undefined}
                >
                  <ServiceIcon name={link.icon} />
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</section>
