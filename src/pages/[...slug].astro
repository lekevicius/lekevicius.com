---
import { getCollection } from 'astro:content'
import Page from '../layouts/Page.astro'
import BlockListRenderer from '../components/blocks/BlockListRenderer.astro'
import type { StrapiContentComponents } from '../lib/strapiTypes'

export async function getStaticPaths() {
  const pages = await getCollection('pages')
  const projects = await getCollection('projects')
  return [
    ...pages.map((page) => ({
      params: {
        slug: page.data.slug,
      },
      props: { page },
    })),
    ...projects.map((project) => ({
      params: {
        slug: project.data.slug,
      },
      props: { page: project },
    })),
  ]
}

const { page } = Astro.props
---

<Page title={page.data.title} description={page.data.description} image={page.data.cover?.url}>
  {page.data.content && <BlockListRenderer data={page.data.content as StrapiContentComponents} />}
</Page>
