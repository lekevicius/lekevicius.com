---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
// import Now from '../components/Now.astro'

// import RSSIcon from '../assets/services/rss.svg'

// import siteData from '../../metadata.json'

import { markdownToHtml } from '../lib/markdown'
import featuredItems from '../content/featured.ts'
import featuredExperience from '../content/featuredExperience.ts'
import NewsletterSection from '../components/NewsletterSection.astro'
import FocusSection from '../components/FocusSection.astro'
import { formatDate } from '../lib/utils'

const allArticles = await getCollection('articles')
const allFeatureds = (await getCollection('featureds')).sort((a, b) => a.data.priority - b.data.priority)
const allProjects = (await getCollection('projects')).sort((a, b) => a.data.releaseDate - b.data.releaseDate)
// console.log(allArticles)
---

<Layout>
  <NewsletterSection />
  <FocusSection />
  <!-- <hr /> -->
  <!-- <Now /> -->
  <!-- <hr /> -->
  <!-- Featured -->
  <section class="side-title-section">
    <div class="side-title-title">
      <h2>Featured</h2>
    </div>
    <div class="side-title-content">
      <ul class="link-grid">
        {
          allFeatureds.map((item) => (
            <li class="link-grid-item">
              <a href={`${item.data.link}`}>
                {item.data.image && (
                  <div class="link-grid-item-image">
                    <img src={item.data.image.formats.thumbnail.url} alt={item.data.title} />
                  </div>
                )}
                <div class="link-grid-item-content">
                  <h3 class="item-title">
                    {item.data.tag && <span class="item-tag">{item.data.tag}</span>}
                    {item.data.title}
                    {item.data.note && <span class="item-note">{item.data.note}</span>}
                  </h3>
                  <p class="item-description">{item.data.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <hr />
  <!-- Writing -->
  <section class="stacked-title-section">
    <div class="stacked-title-title">
      <h2>Writing</h2>
    </div>
    <div class="stacked-title-content">
      <ul class="entry-grid articles-grid">
        {
          allArticles.map((article, index) => {
            const year = new Date(article.data.createdAt).getFullYear()
            return (
              <li class="entry-grid-item articles-grid-item">
                <a href={`/${year}/${article.data.slug}`} title={article.data.title}>
                  <div class="article-date entry-grid-side-title">{formatDate(article.data.createdAt)}</div>
                  <div class="entry-grid-content-subgrid">
                    <h3 class="item-title">
                      {article.data.tag && <span class="item-tag">{article.data.tag}</span>}
                      {article.data.title}
                      {article.data.note && <span class="item-note">{article.data.note}</span>}
                    </h3>
                    {index < 3 && <p class="item-description">{article.data.description}</p>}
                  </div>
                </a>
              </li>
            )
          })
        }
      </ul>
      <!-- <div class="entry-grid-footer justify-between">
        <a href="/writing/" class="inline-block-link">Show All Articles…</a>
        <a href="/feed.xml" class="inline-block-link flex! items-center gap-x-1 text-text/30!"><RSSIcon class="size-4" /> RSS</a>
      </div> -->
    </div>
  </section>
  <hr />
  <!-- Projects -->
  <section class="side-title-section">
    <div class="side-title-title">
      <h2>Projects</h2>
    </div>
    <div class="side-title-content">
      <ul class="link-grid">
        {
          allProjects.map((item) => (
            <li class="link-grid-item">
              <a href={`/${item.data.slug}`}>
                {item.data.image && (
                  <div class="link-grid-item-image">
                    <img src={item.data.image.formats.thumbnail.url} alt={item.data.title} />
                  </div>
                )}
                <div class="link-grid-item-content">
                  <h3 class="item-title">
                    {item.data.tag && <span class="item-tag">{item.data.tag}</span>}
                    {item.data.title}
                    {item.data.note && <span class="item-note">{item.data.note}</span>}
                  </h3>
                  <p class="item-description">{item.data.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <!-- <div class="side-title-footer">
        <a href="/projects/" class="inline-block-link">Show All Projects…</a>
      </div> -->
    </div>
  </section>
  <hr />
  <!-- Experience -->
  <section class="stacked-title-section">
    <div class="stacked-title-title">
      <h2>Experience</h2>
    </div>
    <div class="stacked-title-content">
      <ul class="entry-grid">
        {
          featuredExperience.map((experience) => {
            return (
              <li class="entry-grid-item featured-experience-item">
                <div class="featured-experience-date entry-grid-side-title">{experience.period}</div>
                <div class="entry-grid-content">
                  {experience.role && experience.company && (
                    <h3 class="featured-experience-title font-bold">
                      {experience.role}, {experience.company}
                    </h3>
                  )}
                  <div set:html={markdownToHtml(experience.description)} />
                </div>
              </li>
            )
          })
        }
      </ul>
      <div class="entry-grid-footer">
        <a href="/resume" class="arrow-link">Full Resume</a>
        <!-- <a href="/profile/" class="arrow-link">Read Profile</a> -->
      </div>
    </div>
  </section>

  <hr />
  <section class="column-blocks column-blocks-links">
    <a href="/profile" class="column-block block-link">
      <h4>Profile</h4>
      <p>Brief auto-biography.</p>
    </a>
    <a href="/talks" class="column-block block-link">
      <h4>Talks</h4>
      <p>My talks.</p>
    </a>
    <a href="/appearances" class="column-block block-link">
      <h4>Appearances</h4>
      <p>Media featuring me.</p>
    </a>
  </section>
  <hr />
  <section class="column-blocks column-blocks-links">
    <a href="/people" class="column-block block-link">
      <h4>People</h4>
      <p>Wonderful makers and thinkers to follow.</p>
    </a>
    <a href="/media" class="column-block block-link">
      <h4>Media</h4>
      <p>Movies, games and more I recommend to everyone.</p>
    </a>
    <a href="/gear" class="column-block block-link">
      <h4>Gear</h4>
      <p>My favorite brands, gear, apps and tools.</p>
    </a>
  </section>
  <hr />
</Layout>
