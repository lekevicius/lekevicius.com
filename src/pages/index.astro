---
import StrapiImage from "../components/StrapiImage.astro";
import Layout from "../layouts/Layout.astro";
import Now from "../components/Now.astro";
import type {
  ArticleEntry,
  ProjectEntry,
  TalkEntry,
  VideoEntry,
} from "../lib/strapiTypes";
import {
  getContentCollection,
  isDevContentEnabled,
  isDevEntry,
} from "../lib/content";

// import RSSIcon from '../assets/services/rss.svg'
// import siteData from '../../metadata.json'

import { markdownToHtml } from "../lib/markdown";
import featuredExperience from "../content/featuredExperience.ts";
import NewsletterSection from "../components/NewsletterSection.astro";
import FocusSection from "../components/FocusSection.astro";
import AboutSection from "../components/AboutSection.astro";
import { formatDate } from "../lib/utils";

const allArticles = ((await getContentCollection("articles")) as ArticleEntry[])
  .sort(
    (a, b) =>
      new Date(b.data.createdAt).getTime() -
      new Date(a.data.createdAt).getTime(),
  )
  .slice(0, 5);
const allProjects = ((await getContentCollection("projects")) as ProjectEntry[])
  .sort(
    (a, b) =>
      new Date(b.data.releasedAt ?? 0).getTime() -
      new Date(a.data.releasedAt ?? 0).getTime(),
  )
  .slice(0, 8);
const featuredProjectIDs = (await import("../content/featuredProjects"))
  .default;
const configuredFeaturedProjects = featuredProjectIDs
  .map((id) => allProjects.find((project) => project.data.slug === id))
  .filter((project): project is ProjectEntry => project !== undefined);
const devFeaturedProjects = allProjects.filter(isDevEntry).slice(0, 4);
const featuredProjects =
  isDevContentEnabled && devFeaturedProjects.length > 0
    ? devFeaturedProjects
    : configuredFeaturedProjects;
const allTalks = ((await getContentCollection("talks")) as TalkEntry[])
  .sort(
    (a, b) =>
      new Date(b.data.presentedAt ?? 0).getTime() -
      new Date(a.data.presentedAt ?? 0).getTime(),
  )
  .slice(0, 3);
const allVideos = ((await getContentCollection("videos")) as VideoEntry[])
  .sort(
    (a, b) =>
      new Date(b.data.releasedAt ?? 0).getTime() -
      new Date(a.data.releasedAt ?? 0).getTime(),
  )
  .slice(0, 3);
const hasMoments = (await getContentCollection("moments")).length > 0;
---

<Layout>
  <NewsletterSection />
  <hr />

  <!-- Projects -->
  <section class="side-title-section">
    <div class="side-title-title">
      <h2>Projects</h2>
    </div>
    <div class="side-title-content">
      <div class="col-span-10 px-4 py-3 flex flex-col gap-y-6">
        <FocusSection />
        <hr />
      </div>
      <ul class="link-grid">
        {
          featuredProjects.map((item) => (
            <li class="link-grid-item">
              <a href={`/${item.data.slug}`}>
                {item.data.image?.formats?.thumbnail && (
                  <div class="link-grid-item-image">
                    <StrapiImage
                      width={156}
                      height={156}
                      loading="eager"
                      src={item.data.image.formats.thumbnail.url}
                      alt={item.data.title ?? ""}
                    />
                  </div>
                )}
                <div class="link-grid-item-content">
                  <h3 class="item-title">
                    {item.data.tag && (
                      <span class="item-tag">{item.data.tag}</span>
                    )}
                    {item.data.title}
                    {item.data.note && (
                      <span class="item-note">{item.data.note}</span>
                    )}
                  </h3>
                  <p class="item-description">{item.data.description}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="side-title-footer">
        <a href="/projects" class="inline-block-link">All Projects…</a>
      </div>
    </div>
  </section>

  <!-- Writing -->
  {
    allArticles.length > 0 && (
      <>
        <hr />
        <section class="stacked-title-section">
          <div class="stacked-title-title">
            <h2>Writing</h2>
          </div>
          <div class="stacked-title-content">
            <ul class="entry-grid articles-grid">
              {allArticles.map((article, index) => {
                const year = new Date(article.data.createdAt).getFullYear();
                return (
                  <li class="entry-grid-item articles-grid-item">
                    <a href={`/${year}/${article.data.slug}`}>
                      <div class="article-date entry-grid-side-title">
                        {formatDate(article.data.createdAt)}
                      </div>
                      <div class="entry-grid-content-subgrid">
                        <h3 class="item-title">{article.data.title}</h3>
                        {index < 3 && (
                          <p class="item-description">
                            {article.data.description}
                          </p>
                        )}
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
            <div class="entry-grid-footer justify-between">
              <a href="/writing" class="inline-block-link">
                All Articles…
              </a>
              {/* <a href="/feed.xml" class="inline-block-link flex! items-center gap-x-1 text-text/30!"><RSSIcon class="size-4" /> RSS</a> */}
            </div>
          </div>
        </section>
      </>
    )
  }

  <!-- Videos -->
  {
    allVideos.length > 0 && (
      <>
        <hr />
        <section class="stacked-title-section">
          <div class="stacked-title-title">
            <h2>Videos</h2>
          </div>
          <div class="stacked-title-content">
            <ul class="entry-grid media-grid">
              {allVideos.map((video) => {
                return (
                  <li class="entry-grid-item media-grid-item">
                    <a href={`/${video.data.slug}`}>
                      <div class="media-date entry-grid-side-title">
                        {formatDate(video.data.releasedAt ?? "")}
                      </div>
                      <div class="entry-grid-content-subgrid">
                        {video.data.image?.formats?.small && (
                          <div class="media-thumbnail">
                            <StrapiImage
                              width={500}
                              height={281}
                              loading="eager"
                              src={video.data.image.formats.small.url}
                              alt={video.data.title ?? ""}
                            />
                          </div>
                        )}
                        <div class="media-info">
                          <h3 class="item-title">
                            {video.data.tag && (
                              <span class="item-tag">{video.data.tag}</span>
                            )}
                            {video.data.title}
                            {video.data.note && (
                              <span class="item-note">{video.data.note}</span>
                            )}
                          </h3>
                          <p class="item-description">
                            {video.data.description}
                          </p>
                        </div>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
            <div class="entry-grid-footer">
              <a href="/videos" class="inline-block-link">
                All Videos…
              </a>
              <a
                href="https://www.youtube.com/@FromFirstPrinciples"
                class="arrow-link"
              >
                Subscribe on YouTube
              </a>
            </div>
          </div>
        </section>
      </>
    )
  }

  <!-- Talks -->
  {
    allTalks.length > 0 && (
      <>
        <hr />
        <section class="stacked-title-section">
          <div class="stacked-title-title">
            <h2>Talks</h2>
          </div>
          <div class="stacked-title-content">
            <ul class="entry-grid media-grid">
              {allTalks.map((talk) => {
                return (
                  <li class="entry-grid-item media-grid-item">
                    <a href={`/${talk.data.slug}`}>
                      <div class="media-date entry-grid-side-title">
                        {formatDate(talk.data.presentedAt ?? "")}
                      </div>
                      <div class="entry-grid-content-subgrid">
                        {talk.data.image?.formats?.small && (
                          <div class="media-thumbnail">
                            <StrapiImage
                              width={500}
                              height={281}
                              loading="lazy"
                              src={talk.data.image.formats.small.url}
                              alt={talk.data.title ?? ""}
                            />
                          </div>
                        )}
                        <div class="media-info">
                          <h3 class="item-title">
                            {talk.data.tag && (
                              <span class="item-tag">{talk.data.tag}</span>
                            )}
                            {talk.data.title}
                            {talk.data.note && (
                              <span class="item-note">{talk.data.note}</span>
                            )}
                          </h3>
                          <p class="item-description">
                            {talk.data.description}
                          </p>
                        </div>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
            <div class="entry-grid-footer">
              <a href="/talks" class="inline-block-link">
                All Talks…
              </a>
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    hasMoments && (
      <Fragment>
        <hr />
        <Now />
      </Fragment>
    )
  }

  <hr />

  <!-- About -->
  <AboutSection />

  <hr />

  <!-- Experience -->
  <section class="stacked-title-section">
    <div class="stacked-title-title">
      <h2>Experience</h2>
    </div>
    <div class="stacked-title-content">
      <ul class="entry-grid">
        {
          featuredExperience.map((experience) => {
            return (
              <li class="entry-grid-item featured-experience-item">
                <div class="featured-experience-date entry-grid-side-title">
                  {experience.period}
                </div>
                <div class="entry-grid-content">
                  {experience.role && experience.company && (
                    <h3 class="featured-experience-title font-bold mb-1">
                      {experience.role}, {experience.company}
                    </h3>
                  )}
                  <div
                    class="opacity-80"
                    set:html={markdownToHtml(experience.description)}
                  />
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <hr />

  <section class="column-blocks column-blocks-links">
    <a href="/resume" class="column-block block-link">
      <h4>Resume</h4>
      <p>Work and education.</p>
    </a>
    <a href="/profile" class="column-block block-link">
      <h4>Profile</h4>
      <p>Brief auto-biography.</p>
    </a>
    <!-- <a href="/talks" class="column-block block-link">
      <h4>Talks</h4>
      <p>My talks.</p>
    </a> -->
    <a href="/appearances" class="column-block block-link">
      <h4>Appearances</h4>
      <p>Media featuring me.</p>
    </a>
  </section>
  <hr />
  <section class="column-blocks column-blocks-links">
    <a href="/people" class="column-block block-link">
      <h4>People</h4>
      <p>Wonderful makers and thinkers to follow on the web.</p>
    </a>
    <a href="/gear" class="column-block block-link">
      <h4>Gear</h4>
      <p>My favorite brands, apps, tools and my setup for home and work.</p>
    </a>
    <a href="/media" class="column-block block-link">
      <h4>Media</h4>
      <p>Movies, games and more I recommend to everyone.</p>
    </a>
  </section>
  <hr />
</Layout>
