---
import Layout from "../layouts/Layout.astro";
import StrapiImage from "../components/StrapiImage.astro";
import PageHeading from "../components/PageHeading.astro";
import type { VideoEntry } from "../lib/strapiTypes";
import { formatDate } from "../lib/utils";
import { getContentCollection } from "../lib/content";

const allVideos = ((await getContentCollection("videos")) as VideoEntry[]).sort(
  (a, b) =>
    new Date(b.data.releasedAt ?? 0).getTime() -
    new Date(a.data.releasedAt ?? 0).getTime(),
);

const title = "Videos";
const description = "Video content, recordings, and more.";
---

<Layout title={title} description={description}>
  <PageHeading title={title} description={description} />
  <section class="stacked-title-section">
    <div class="stacked-title-content">
      <ul class="entry-grid media-grid">
        {
          allVideos.map((video) => {
            return (
              <li class="entry-grid-item media-grid-item">
                <a href={`/${video.data.slug}`}>
                  <div class="media-date entry-grid-side-title">
                    {formatDate(video.data.releasedAt ?? "")}
                  </div>
                  <div class="entry-grid-content-subgrid">
                    {video.data.image?.formats?.small && (
                      <div class="media-thumbnail">
                        <StrapiImage
                          width={500}
                          height={281}
                          loading="eager"
                          src={video.data.image.formats.small.url}
                          alt={video.data.title ?? ""}
                        />
                      </div>
                    )}
                    <div class="media-info">
                      <h3 class="item-title">
                        {video.data.tag && (
                          <span class="item-tag">{video.data.tag}</span>
                        )}
                        {video.data.title}
                        {video.data.note && (
                          <span class="item-note">{video.data.note}</span>
                        )}
                      </h3>
                      <p class="item-description">{video.data.description}</p>
                    </div>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
  <hr />
</Layout>
