---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found" description="Page Not Found">
  <hr />
  <main class="content-container">
    <div class="content-side-label opacity-60">Error 404</div>
    <div class="content-main">
      <h1 class="text-3xl leading-8 font-bold mb-2">Page Not Found</h1>
      <p class="text-xl leading-8 mt-4">
        Sorry, the page you are looking for does not exist.
      </p>
    </div>
    <div class="content-blocks">
      <div class="prose">
        <hr class="mt-8" />
        <p>
          For whatever reason, this page could not be found. Was it here before?
          Maybe it was moved or deleted. You can go back to the <a href="/"
            >homepage</a
          >, but if you think this is an error, please get in touch using links
          below.
        </p>
      </div>
    </div>
  </main>
  <hr />
</Layout>
