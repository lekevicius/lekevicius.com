---
import EmailIcon from '../assets/services/email.svg'
import SignalIcon from '../assets/services/signal.svg'
import TelegramIcon from '../assets/services/telegram.svg'
import MessengerIcon from '../assets/services/messenger.svg'

import BlueskyIcon from '../assets/services/bluesky.svg'
import MastodonIcon from '../assets/services/mastodon.svg'
import XIcon from '../assets/services/x.svg'
import InstagramIcon from '../assets/services/instagram.svg'

import LinkedInIcon from '../assets/services/linkedin.svg'
import GitHubIcon from '../assets/services/github.svg'
import LetterboxdIcon from '../assets/services/letterboxd.svg'
import ENSIcon from '../assets/services/ens.svg'
---

<section class="column-blocks contact-section">
  <div class="column-block">
    <h4>Contact</h4>
    <ul class="contact-links">
      <li>
        <a href="mailto:jonas@lekevicius.com" title="Email" aria-label="Email">
          <EmailIcon />
        </a>
      </li>
      <li>
        <a href="https://signal.me/#eu/519y9OoMmKjPzHFsP0XUP5MNP8lnBpytNLLocKpiIcX-x_LnkrpOu7Zs7uH96Ka7" title="Signal" aria-label="Signal">
          <SignalIcon />
        </a>
      </li>
      <li>
        <a href="https://t.me/lekevicius" title="Telegram" aria-label="Telegram">
          <TelegramIcon />
        </a>
      </li>
      <li>
        <a href="https://m.me/lekevicius" title="Messenger" aria-label="Messenger">
          <MessengerIcon />
        </a>
      </li>
    </ul>
  </div>
  <div class="column-block">
    <h4>Follow</h4>
    <ul class="contact-links">
      <li>
        <a href="https://bsky.app/profile/lekevicius.com" title="Bluesky" aria-label="Bluesky">
          <BlueskyIcon />
        </a>
      </li>
      <li>
        <a href="https://mastodon.social/@lekevicius" title="Mastodon" aria-label="Mastodon">
          <MastodonIcon />
        </a>
      </li>
      <li>
        <a href="https://x.com/lekevicius" title="X" aria-label="X">
          <XIcon />
        </a>
      </li>
      <li>
        <a href="https://instagram.com/lekevicius" title="Instagram" aria-label="Instagram">
          <InstagramIcon />
        </a>
      </li>
    </ul>
  </div>
  <div class="column-block">
    <h4>Elsewhere</h4>
    <ul class="contact-links">
      <li>
        <a href="https://linkedin.com/in/lekevicius" title="LinkedIn" aria-label="LinkedIn">
          <LinkedInIcon />
        </a>
      </li>
      <li>
        <a href="https://github.com/lekevicius" title="GitHub" aria-label="GitHub">
          <GitHubIcon />
        </a>
      </li>
      <li>
        <a href="https://letterboxd.com/lekevicius" title="Letterboxd" aria-label="Letterboxd">
          <LetterboxdIcon />
        </a>
      </li>
      <li>
        <a href="https://keybase.io/lekevicius" title="GPG Key" aria-label="GPG Key">
          <ENSIcon />
        </a>
      </li>
    </ul>
  </div>
</section>
