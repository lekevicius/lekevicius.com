---
import '../styles/global.css';
import siteData from '../content/metadata.json';
import { ClientRouter } from 'astro:transitions';
import Analytics from './Analytics.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description, image } = Astro.props;

let pageTitle = title ? `${title} - ${siteData.title}` : siteData.title;
const pageDescription = description ? description.replace(/<[^>]+>/g, '').trim() : siteData.description;
let pageImage = `${siteData.siteUrl}${image ? image : '/share-image.png'}`;
let pageLocation = `${siteData.siteUrl}${Astro.url.pathname}`;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />

  <title>{pageTitle}</title>
  <meta property="og:title" content={pageTitle} />
  <meta name="twitter:title" content={pageTitle} />
  <meta property="og:site_name" content={siteData.title} />
  <meta property="og:type" content="website" />

  <meta name="description" content={pageDescription} />
  <meta property="og:description" content={pageDescription} />
  <meta name="twitter:description" content={pageDescription} />

  <link rel="canonical" href={pageLocation} />
  <meta property="og:url" content={pageLocation} />
  <meta name="twitter:url" content={pageLocation} />

  <meta name="author" content={siteData.author} />
  <meta name="twitter:site" content="@lekevicius" />
  <meta name="twitter:creator" content="@lekevicius" />
  <link type="text/plain" rel="author" href="/humans.txt" />

  <meta property="og:image" content={pageImage} />
  <meta name="twitter:image" content={pageImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="msapplication-TileColor" content="#333333" />
  <meta name="msapplication-TileImage" content="/tileicon.png" />

  <meta name="apple-mobile-web-app-title" content="Lekevicius" />
  <meta name="apple-mobile-web-app-capable" content="yes" />

  <link rel="sitemap" href="/sitemap-index.xml" />

  <Analytics />
  <ClientRouter />
  <script>
    let angle = 0;
    function animate() {
      angle = (angle + 4) % 360;
      document.documentElement.style.setProperty('--border-angle', angle + 'deg');
      requestAnimationFrame(animate);
    }
    animate();
  </script>
</head>
