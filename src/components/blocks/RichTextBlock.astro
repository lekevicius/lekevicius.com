---
import type { StrapiRichTextComponent } from "../../lib/strapiTypes";
import { markdownToHtml } from "../../lib/markdown";

type Props = {
  data: StrapiRichTextComponent;
};

const { data } = Astro.props;
---

<div class="prose rich-text-block">
  {data.body && <div set:html={markdownToHtml(data.body)} />}
</div>
