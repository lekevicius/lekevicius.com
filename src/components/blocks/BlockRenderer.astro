---
// import TextBlock from './TextBlock.astro'
import RichTextBlock from './RichTextBlock.astro'
import MediaBlock from './MediaBlock.astro'
// import QuoteBlock from './QuoteBlock.astro'
// import CTABlock from './CTABlock.astro'
// import HeroBlock from './HeroBlock.astro'

import type {
  StrapiContentComponent,
  StrapiContentRichTextComponent,
  StrapiContentMediaComponent,
  // StrapiContentQuoteComponent,
} from '../../lib/strapiTypes'

type Props = {
  data: StrapiContentComponent
}

const { data } = Astro.props
---

{data.__component === 'shared.rich-text' && <RichTextBlock data={data as StrapiContentRichTextComponent} />}
{data.__component === 'shared.media' && <MediaBlock data={data as StrapiContentMediaComponent} />}
