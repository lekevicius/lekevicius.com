---
import type { StrapiSlideComponent } from "../../lib/strapiTypes";
import { markdownToHtml } from "../../lib/markdown";
import { Image } from "astro:assets";

type Props = {
  data: StrapiSlideComponent;
};

const { data } = Astro.props;
const alt = data.image?.alternativeText || "";
---

<figure
  class="slide-block col-span-full flex flex-col md:grid grid-cols-subgrid px-4 py-3 md:px-0 md:py-0 gap-4 md:gap-0"
>
  <div class="md:col-span-5 md:px-4 md:py-3">
    {
      data.image && (
        <Image
          src={data.image.url}
          width={data.image.width || 1920}
          height={data.image.height || 1080}
          loading={"eager"}
          alt={alt}
          class="w-full h-auto rounded-lg"
        />
      )
    }
  </div>
  <figcaption class="md:col-span-7 prose md:px-4 md:py-3">
    <div set:html={markdownToHtml(data.text ?? "")} />
  </figcaption>
</figure>
