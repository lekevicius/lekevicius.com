---
import { Image } from 'astro:assets';
// import PixelPhoto from '../assets/images/pixel-photo.png';
import FloatingPortrait from '../assets/images/floating-portrait.png';
---

<section class="side-title-section">
  <div class="side-title-title">
    <h2>About</h2>
  </div>
  <div class="side-title-content">
    <!-- flex flex-col md:grid grid-cols-subgrid col-span-12 -->
    <div class="col-span-2 px-4 pt-3 pb-0 md:pb-3">
      <div class="flex md:justify-center">
        <!-- <img loading="lazy" src={PixelPhoto.src} alt="Me in 64x64 pixels" class="size-48 grayscale brightness-110 mix-blend-luminosity" style="image-rendering: pixelated; image-rendering: -moz-crisp-edges; image-rendering: crisp-edges" /> -->
        <Image
          inferSize
          loading="lazy"
          src={FloatingPortrait}
          alt="Portrait of me"
          class="mix-blend-luminosity dark:mix-blend-hard-light max-w-32"
        />
      </div>
    </div>
    <div class="col-span-8 px-4 py-3">
      <p>
        I am a maker, living in Vilnius, Lithuania. I have been designing and developing digital things for nearly 20
        years, having started by building websites in middle school. I studied arts and design, and hold a BA degree in
        Graphic Design from Vilnius Academy of Arts.
      </p>
    </div>
  </div>
</section>
