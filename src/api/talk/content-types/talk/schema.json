{
  "kind": "collectionType",
  "collectionName": "talks",
  "info": {
    "singularName": "talk",
    "pluralName": "talks",
    "displayName": "Talk"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "recordingLink": {
      "type": "string"
    },
    "presentedAt": {
      "type": "date"
    },
    "description": {
      "type": "string"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "tag": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "shared.rich-text",
        "shared.media",
        "shared.slide"
      ]
    }
  }
}
