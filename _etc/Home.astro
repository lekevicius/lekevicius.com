---
import blockOrder from '../content/home/blocks.json'

import PlaceholderBlock from '../blocks/placeholder/block.astro'
import NewsletterBlock from '../blocks/newsletter/block.astro'
import ProfileBlock from '../blocks/profile/block.astro'
import ContactBlock from '../blocks/contact/block.astro'
import SocialBlock from '../blocks/social/block.astro'

// import NFTGalleryBlock from '../blocks/nft-gallery/block.astro'
import JobsBlock from '../blocks/jobs/block.astro'
import ClientsBlock from '../blocks/clients/block.astro'
import LoopBlock from '../blocks/loop/block.astro'
import DuBitaiBlock from '../blocks/du-bitai/block.astro'

import { blend } from './Header.astro'

const blocks = {
  placeholder: PlaceholderBlock,

  newsletter: NewsletterBlock,
  profile: ProfileBlock,
  contact: ContactBlock,
  social: SocialBlock,
  jobs: JobsBlock,
  clients: ClientsBlock,

  loop: LoopBlock,
  'du-bitai': DuBitaiBlock,
} as const
type blockKey = keyof typeof blocks
---

<p class={`text-xl lg:text-2xl px-6 my-8 lg:my-16 lg:max-w-none ${blend}`}>
  I am inventing on the internet. Previously a product designer,
  <br class="hidden lg:inline" /> now independent maker building my own ideas.
</p>
<main class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-10 items-stretch w-full feed">
  {
    false && ( // Tailwind class creation
      <>
        <div class="col-span-1 lg:col-span-1" />
        <div class="col-span-2 lg:col-span-2" />
        <div class="col-span-3 lg:col-span-3" />
        <div class="col-span-4 lg:col-span-4" />
        <div class="col-span-5 lg:col-span-5" />
        <div class="col-span-6 lg:col-span-6" />
        <div class="col-span-7 lg:col-span-7" />
        <div class="col-span-8 lg:col-span-8" />
        <div class="col-span-9 lg:col-span-9" />
        <div class="col-span-10 lg:col-span-10" />
        <div class="col-span-11 lg:col-span-11" />
        <div class="col-span-12 lg:col-span-12" />
      </>
    )
  }
  {
    blockOrder.map(line => {
      let colsWithPrefs = 0
      let widthPrefSum = 0
      let widthPrefs = line.map(item => {
        if (typeof item === 'object' && !Array.isArray(item) && item.w) {
          colsWithPrefs++
          widthPrefSum += item.w
          return item.w
        } else return 0
      })
      let unprefWidth = (12 - widthPrefSum) / (line.length - colsWithPrefs)
      let widths = widthPrefs.map(width => (width === 0 ? unprefWidth : width))

      return (
        <Fragment>
          {line.map((item, itemIndex) => {
            let contentKey: blockKey | blockKey[] =
              typeof item === 'object' && !Array.isArray(item) && item.w
                ? (item.c as blockKey)
                : (item as blockKey | blockKey[])

            if (Array.isArray(contentKey)) {
              return (
                <div class={`feed flex flex-col gap-4 lg:gap-10 col-span-1 lg:col-span-${widths[itemIndex]}`}>
                  {contentKey.map(subitem => {
                    let Comp = subitem in blocks ? blocks[subitem] : blocks['placeholder']
                    return <Comp key={subitem} classes="feed-block rounded-3xl" />
                  })}
                </div>
              )
            } else {
              let Comp = contentKey in blocks ? blocks[contentKey] : blocks['placeholder']
              return (
                <Comp key={contentKey} classes={`feed-block col-span-1 lg:col-span-${widths[itemIndex]} rounded-3xl`} />
              )
            }
          })}
        </Fragment>
      )
    })
  }
  <div id="container">
    <div id="inner"></div>
  </div>
</main>
<style is:global>
  .feed {
    perspective: 500px;
    transition: perspective-origin 0.3s;
  }
  .feed-block {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    transition:
      scale 0.3s,
      box-shadow 0.3s,
      transform 0.3s;

    box-shadow:
      0 1px 3px 0 rgb(0 0 0 / 0.1),
      0 1px 2px -1px rgb(0 0 0 / 0.1);
  }
  .feed-block.hover {
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.35);
  }
  .feed-block.immediate-transform {
    transition: transform 0s;
  }
</style>
<script>
  let origin = { x: 0, y: 0 }
  let size = { width: 0, height: 0 }
  let relative = { x: 0, y: 0 }
  let currentElement: HTMLElement | null = null
  let timeout: NodeJS.Timeout | null = null
  const rotationMultiplier = 20

  function closestParent(element: HTMLElement | null, selector: string): HTMLElement | null {
    while (element) {
      if (element.matches(selector)) {
        return element
      }
      element = element.parentElement
    }
    return null
  }

  const updatePosition = (event: MouseEvent) => {
    relative = {
      x: (event.pageX - origin.x) * -1,
      y: (event.pageY - origin.y) * 1,
    }
  }

  const setOrigin = (target: HTMLElement) => {
    currentElement = target
    const rect = target.getBoundingClientRect()
    origin = {
      x: rect.left + window.scrollX + rect.width / 2,
      y: rect.top + window.scrollY + rect.height / 2,
    }
    size = {
      width: rect.width,
      height: rect.height,
    }

    const parentElement = closestParent(target, '.feed')
    if (!parentElement) {
      return
    }
    const feedRect = parentElement.getBoundingClientRect()
    const feedOrigin = {
      x: feedRect.left + window.scrollX,
      y: feedRect.top + window.scrollY,
    }
    parentElement.style.perspectiveOrigin = `${origin.x - feedOrigin.x}px ${origin.y - feedOrigin.y}px`
    timeout = setTimeout(() => {
      target.classList.add('immediate-transform')
    }, 300)
  }

  const update = function (event: MouseEvent) {
    updatePosition(event)
    const element = event.currentTarget as HTMLElement
    element.style.transform = `rotateX(${(relative.y / Math.pow(size.height, 1.25)) * rotationMultiplier}deg) rotateY(${(relative.x / Math.pow(size.width, 1.25)) * rotationMultiplier}deg)`
    element.style.scale = '1.03'
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.feed-block').forEach(element => {
      element.addEventListener('mouseenter', event => {
        setOrigin(event.currentTarget as HTMLElement)
        update(event as MouseEvent)
        element.classList.add('hover')
      })
      element.addEventListener('mousemove', event => {
        update(event as MouseEvent)
      })
      element.addEventListener('mouseleave', event => {
        const element = event.currentTarget as HTMLElement
        element.style.transform = 'rotateX(0deg) rotateY(0deg)'
        element.style.scale = '1'
        element.classList.remove('hover', 'immediate-transform')
        if (timeout) {
          clearTimeout(timeout)
        }
      })
    })
  })
</script>
