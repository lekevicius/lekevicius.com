---
import RSSIcon from '../assets/images/rss.svg?raw'
import { blend } from './Header.astro'
---

<main>
  <p class={`text-xl lg:text-2xl px-6 mt-8 lg:mt-16 lg:max-w-none ${blend}`}>
    I am inventing on the internet. Previously a product designer,
    <br class="hidden lg:inline" /> now independent maker building my own ideas.
  </p>
  <div class="px-6 mt-6 flex gap-8">
    <a href="/feed.xml" class=`flex font-semibold gap-1 ${blend}`>
      <Fragment set:html={RSSIcon} />
      Updates Feed
    </a>
    <a href="/feed-articles.xml" class=`flex font-semibold gap-1 ${blend}`>
      <Fragment set:html={RSSIcon} />
      Articles Feed
    </a>
  </div>
</main>
