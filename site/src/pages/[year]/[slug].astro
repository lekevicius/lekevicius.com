---
import Page from "../../layouts/Page.astro";
import BlockListRenderer from "../../components/blocks/BlockListRenderer.astro";
import type {
  StrapiContentComponents,
  ArticleEntry,
} from "../../lib/strapiTypes";
import { getStrapiMediaUrl } from "../../lib/strapiTypes";
import { formatDate } from "../../lib/utils";
import { getContentCollection } from "../../lib/content";

export async function getStaticPaths() {
  const articles = (await getContentCollection("articles")) as ArticleEntry[];
  return articles.map((article) => ({
    params: {
      year: new Date(article.data.createdAt).getFullYear().toString(),
      slug: article.data.slug,
    },
    props: { article },
  }));
}

const { article } = Astro.props as { article: ArticleEntry };
---

<Page
  title={article.data.title ?? ""}
  description={article.data.description ?? undefined}
  image={getStrapiMediaUrl(article.data.cover?.url)}
  sideLabel={formatDate(article.data.createdAt, "long")}
>
  <BlockListRenderer data={article.data.content as StrapiContentComponents} />
</Page>
