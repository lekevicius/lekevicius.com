      <button
        class="py-1.75 px-4 font-bold text-base leading-6 rounded-lg text-text bg-text/8 border-text/5 border focus:outline-none focus:ring-0 focus:bg-text/12 hover:bg-text/12 transition-colors cursor-pointer"
        >Subscribe</button
      >
    </form>
