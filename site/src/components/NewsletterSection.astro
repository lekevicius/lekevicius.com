<section class="side-title-section">
  <div class="side-title-title flex items-center">
    <h2>Newsletter</h2>
  </div>
  <div class="side-title-content items-center">
    <p class="md:col-span-5 py-3 px-4 leading-6">
      Monthly issue about what I learned and built.
    </p>
    <form
      class="md:col-span-5 py-3 px-4 flex gap-x-3"
      action="https://buttondown.email/api/emails/embed-subscribe/lekevicius"
      method="post"
      target="popupwindow"
    >
      <input
